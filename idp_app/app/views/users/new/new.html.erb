<h1>新規会員登録</h1>

<%= form_with model: @user, url: users_new_path, method: :post, local: true do |form| %>
  <% if @user.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email %>
  </div>

  <div class="field">
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password %>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "パスワード確認" %>
    <%= form.password_field :password_confirmation %>
  </div>

  <div class="field">
    <%= form.label :name, "氏名" %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :date_of_birth, "生年月日" %>
    <%= form.date_field :date_of_birth %>
  </div>

  <div class="field">
    <%= form.label :address, "住所" %>
    <%= form.text_area :address %>
  </div>

  <div class="field">
    <%= form.label :phone_number, "電話番号" %>
    <%= form.text_field :phone_number %>
  </div>

  <div class="actions">
    <%= form.submit "確認画面へ", class: "btn btn-primary" %>
    <%= link_to "戻る", root_path, class: "btn btn-secondary" %>
  </div>
<% end %>